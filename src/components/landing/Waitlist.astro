---
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { Image } from 'astro:assets';
import paymentLogos from '../../images/assets/tarjetas-aceptadas.png';
---

<section id="waitlist" class="py-10">
  <Wrapper variant="standard">
    <div class="bg-gray-50 rounded-xl px-8 py-8">
<div class="max-w-xl mx-auto text-center space-y-6">
  <a 
  href="/pricing" 
  class="inline-block bg-[#c2f3d8] hover:bg-[#a8e6c5] text-[#1a1a1a] px-8 py-3 rounded-full transition-all duration-300 text-sm font-medium tracking-wide shadow-sm"
>
  Book Your Visa Service
</a>

  <div style="display: flex; justify-content: center; margin-top: 1.5rem;">
    <Image src={paymentLogos} alt="We accept Visa, Mastercard and AMEX" width={300} />
  </div>
</div>

      <Text tag="p" variant="textXS" class="text-base-400">
        
      </Text>

    </div>
  </Wrapper>
</div>

</section>


