---
import Text from "@/components/fundations/elements/Text.astro";
import Layout from "@/layouts/BaseLayout.astro";
---

<Layout title="Thank you - Madrid Landing Kit">
  <section class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
    <Text tag="h1" variant="displaySM" class="mb-4">
      Thank you for trusting us with your visa process! We have received your payment. Our team will contact you via WhatsApp or Email within the next 24 hours to begin reviewing your documentation. If you have any questions, feel free to reply to the confirmation email." ✈️
    </Text>
    
    

    <a
  href="/"
  class="inline-block rounded-full bg-[#C2F2F9] px-8 py-3 text-[13px] text-black font-semibold hover:opacity-80 transition-all duration-300 shadow-sm"
>
  Back to Home
</a>
    
      
    </a>
  </section>
</Layout>