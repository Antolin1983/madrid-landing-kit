---
import Text from "@/components/fundations/elements/Text.astro";
import Layout from "@/layouts/BaseLayout.astro";
---

<Layout title="Thank you - Madrid Landing Kit">
  <section class="flex flex-col items-center justify-center min-h-[70vh] px-6 py-20 text-center">
    <div class="mb-8 text-4xl">✈️</div>

    <div class="max-w-2xl mx-auto">
      <Text tag="h1" variant="displaySM" class="text-base-900 font-medium tracking-tight">
        Payment Successful!
      </Text>
      
      <Text tag="p" variant="textLG" class="mt-6 text-base-600 leading-relaxed">
        Thank you for trusting us with your visa process. We have received your payment correctly. 
        <br class="hidden md:block" />
        Our team will contact you via <strong>WhatsApp or Email</strong> within the next 24 hours to begin reviewing your documentation.
      </Text>

      <Text tag="p" variant="textSM" class="mt-4 text-base-400 italic">
        If you have any questions, feel free to reply to the confirmation email.
      </Text>
    </div>

    <div class="mt-12">
      <a
        href="/"
        class="inline-flex items-center justify-center rounded-full bg-[#C2F2F9] px-10 py-4 text-sm text-black font-bold hover:bg-[#a8e4ed] transition-all duration-300 shadow-sm"
      >
        Back to Home
      </a>
    </div>
  </section>
</Layout>