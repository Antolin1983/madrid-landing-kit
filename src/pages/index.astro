---
import { getHome } from '../lib/sanity'
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getFeaturedGuides } from "@/lib/sanity";

const home = await getHome();
const featuredGuides = await getFeaturedGuides(3);



const title =
"Your Spanish Student Visa Simplified – Madrid Landing Kit"
const description =
"Expert help for US students moving to Madrid. We handle your Student Visa application, BLS appointments, and paperwork so you can focus on your trip.";



import Hero from "@/components/landing/Hero.astro";
import Learn from "@/components/landing/Learn.astro";
import Who from "@/components/landing/Who.astro";
import Expectations from "@/components/landing/Expectations.astro";
import Waitlist from "@/components/landing/Waitlist.astro";
import ParentsPhotos from "@/components/landing/ParentsPhotos.astro";
///import Stats from "@/components/landing/Stats.astro";
///import Testimonials from "@/components/testimonials/Testimonials.astro";
---

<BaseLayout title={title} description={description}>
  <Hero />

  {/* Learn Top */}
  <Learn data={home?.learnSection} />

  <Waitlist />
    {/* Learn Bottom */}
  <Learn data={home?.learnSectionBottom} />

  <ParentsPhotos />

  <Waitlist />
  
  <Who />

  <Expectations />

  <Waitlist />


<!-- SEO: internal links to guides -->
<nav aria-label="Guides" class="seo-guides">
  <ul>
    {featuredGuides.map((guide) => (
      <li>
        <a href={`/guides/${guide.slug.current}`}>
          {guide.title}
        </a>
      </li>
    ))}
  </ul>
</nav>


  {/* <Stats/> */}
  {/* <Testimonials /> */}

</BaseLayout>

<a 
  href="https://wa.me/34636781776?text=Hi!%20I'm%20coming%20to%20Madrid%20and%20I'd%20like%20help%20with%20my%20visa." 
  style="
    position: fixed;
    bottom: 20px;
    right: 20px;
    background-color: #25d366;
    color: white;
    border-radius: 50px;
    text-align: center;
    font-size: 30px;
    box-shadow: 2px 2px 3px #999;
    z-index: 1000;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  " 
  target="_blank"
>
  <img src="https://upload.wikimedia.org/wikipedia/commons/6/6b/WhatsApp.svg" width="35" alt="WhatsApp" />
</a>

<style>
  .featured-guides {
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  .featured-guides h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
  }

  .guides-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
  }

  .guide-card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .guide-card p {
    color: #555;
    font-size: 0.95rem;
  }
  .seo-guides {
  position: absolute;
  left: -9999px;
  top: auto;
  width: 1px;
  height: 1px;
  overflow: hidden;
}
</style>


